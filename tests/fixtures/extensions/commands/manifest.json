{
  "manifest_version": 3,
  "name": "Vsesvit Commands",
  "version": "1.0.0",
  "description": "Test extension for commands.",
  "browser_specific_settings": { "gecko": { "id": "commands@vsesvit.test" } },
  "permissions": ["activeTab", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Vsesvit Commands", "default_popup": "popup.html" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+A" } },
    "free": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Free key" },
    "taken": { "suggested_key": { "default": "Ctrl+T" }, "description": "The browser's key" },
    "keyless": { "description": "No key" }
  }
}
