+/// vsesvit patch: whether `hwnd` is a GPUI window (class `Zed::Window`).
+/// `GPUI_SPIKE_UNPATCHED=1` restores the upstream behaviour for comparison.
+fn is_gpui_window(hwnd: HWND) -> bool {
+    static UNPATCHED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if *UNPATCHED.get_or_init(|| std::env::var("GPUI_SPIKE_UNPATCHED").is_ok_and(|v| v == "1")) {
+        return true;
+    }
+    let mut buf = [0u16; 32];
+    let n = unsafe { GetClassNameW(hwnd, &mut buf) };
+    n > 0 && String::from_utf16_lossy(&buf[..n as usize]) == "Zed::Window"
+}
