{
  "manifest_version": 3,
  "name": "Spy",
  "version": "1.0.0",
  "description": "spike-ext-api probe for extension APIs under GPUI + Chrome-style CEF children.",
  "key": "",
  "permissions": ["tabs", "activeTab", "scripting", "storage", "alarms", "offscreen", "sidePanel", "downloads", "identity", "contextMenus", "notifications"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_end", "all_frames": true }],
  "action": { "default_title": "Spy", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+U" } },
    "spy-cmd": { "suggested_key": { "default": "Alt+Shift+Y" }, "description": "Spy command" }
  }
}
