+    /// Vsesvit patch: key events delivered to a focus proxy are handled as the toplevel's.
+    fn map_focus_proxy(&self, event: Event) -> Event {
+        let state = self.0.borrow();
+        if state.focus_proxies.is_empty() {
+            return event;
+        }
+        match event {
+            Event::KeyPress(mut e) => {
+                if let Some(top) = state.focus_proxies.get(&e.event) {
+                    e.event = *top;
+                }
+                Event::KeyPress(e)
+            }
+            Event::KeyRelease(mut e) => {
+                if let Some(top) = state.focus_proxies.get(&e.event) {
+                    e.event = *top;
+                }
+                Event::KeyRelease(e)
+            }
+            other => other,
+        }
+    }
