#!/bin/sh
# Entry point of the Vsesvit AppImage. libwebkitgtk-6.0 was patched so its helper directory
# starts with ./wk instead of /usr (usr/wk links to usr), which resolves only from $APPDIR/usr;
# the browser therefore runs from there, with path arguments made absolute first. The web
# process sandbox keeps that working directory, and the browser adds $APPDIR to the sandbox, so
# it must be this directory as resolved here, also in an extracted image started by hand.
here="$(dirname "$(readlink -f "$0")")"
export APPDIR="$here"
lib="$here/usr/lib/x86_64-linux-gnu"

export LD_LIBRARY_PATH="$lib:$here/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$here/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$here/usr/share/glib-2.0/schemas"
export GIO_MODULE_DIR="$lib/gio/modules"
export GST_PLUGIN_SYSTEM_PATH_1_0="$lib/gstreamer-1.0"
export GST_PLUGIN_SCANNER_1_0="$lib/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner"
# The web process sandbox needs the host's bubblewrap at /usr/bin/bwrap and the namespaces it
# creates, which some containers and hardened kernels refuse. WebKit cannot start a web process
# there with the sandbox on, so it is turned off, with a warning; this is the check WebKit
# itself makes inside podman.
if ! /usr/bin/bwrap --ro-bind / / --proc /proc --dev /dev --unshare-all true 2>/dev/null; then
  echo 'vsesvit: bubblewrap cannot sandbox here, so web pages run without the sandbox' >&2
  export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
fi

# Caches that must not be shared with a system GStreamer or gdk-pixbuf of another version. The
# pixbuf loader cache holds absolute paths, so it is rewritten for the current mount point.
cache="${XDG_CACHE_HOME:-$HOME/.cache}/vsesvit/appimage"
mkdir -p "$cache" 2>/dev/null || cache="$(mktemp -d)"
export GST_REGISTRY_1_0="$cache/gst-registry.bin"
export GDK_PIXBUF_MODULE_FILE="$cache/loaders.cache"
"$lib/gdk-pixbuf-2.0/gdk-pixbuf-query-loaders" "$lib"/gdk-pixbuf-2.0/2.10.0/loaders/*.so > "$GDK_PIXBUF_MODULE_FILE"

# Paths are resolved against the directory the user ran the image from (OWD, set by the
# runtime): --profile-dir and --self-test values always, since they may not exist yet, and
# other arguments when they name an existing file, so a bare host stays a host.
owd=${OWD:-$PWD}
abs() {
  case $1 in
    /*) printf '%s' "$1" ;;
    *) printf '%s/%s' "$owd" "$1" ;;
  esac
}
n=$#
value=
rest=
while [ "$n" -gt 0 ]; do
  arg=$1
  shift
  if [ -n "$value" ]; then
    value=
    [ -n "$arg" ] && arg=$(abs "$arg")
  elif [ -n "$rest" ]; then
    [ -e "$arg" ] && arg=$(readlink -f -- "$arg")
  else
    case $arg in
      --) rest=1 ;;
      --profile-dir | --self-test) value=1 ;;
      --profile-dir=?* | --self-test=?*) arg="${arg%%=*}=$(abs "${arg#*=}")" ;;
      -*) ;;
      *) [ -e "$arg" ] && arg=$(readlink -f -- "$arg") ;;
    esac
  fi
  set -- "$@" "$arg"
  n=$((n - 1))
done

cd "$here/usr" || exit 1
exec "$here/usr/lib/vsesvit/vsesvit" "$@"
